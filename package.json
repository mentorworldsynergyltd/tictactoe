{
  "name": "tictactoe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n vite,server -c blue,magenta \"npm:dev\" \"npm:server\"",
    "build": "tsc -b && vite build",
    "build:mobile-server": "esbuild server/android-entry.ts --bundle --platform=node --target=node18 --format=cjs --outfile=public/nodejs/main.js --external:bridge --external:bufferutil --external:utf-8-validate",
    "build:android": "npm run build:mobile-server && npm run build && npx cap sync android",
    "start": "npm run build && tsx server/index.ts",
    "build:relay": "esbuild server/relay-entry.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-relay/relay.cjs --external:bufferutil --external:utf-8-validate",
    "start:relay": "node dist-relay/relay.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:engine": "tsx scripts/engine.check.ts",
    "test:ai": "tsx scripts/ai.check.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capawesome/capacitor-nodejs": "^0.1.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  }
}
