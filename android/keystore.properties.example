# Copy this file to android/keystore.properties and fill in your real values.
# android/keystore.properties is gitignored — never commit it or the .keystore
# file it points to. See PLAY_STORE_CHECKLIST.md at the project root for how
# this keystore was generated and why it matters.
#
# storeFile is resolved relative to the android/ directory (where this file
# lives once renamed), so the simplest setup is to drop your .keystore file
# directly in android/ and reference it by name as shown below. You can also
# use an absolute path if you'd rather keep it somewhere outside the project.

storeFile=tictactoe-release.keystore
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyAlias=tictactoe-release
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
